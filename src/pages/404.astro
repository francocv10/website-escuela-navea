---
import { withBase } from '../utils/url';
import Button from '../components/ui/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada" noindex>
  <div class="stripes h-3.5" aria-hidden="true"></div>
  <section class="bg-ink">
    <div class="mx-auto flex max-w-[720px] flex-col items-center gap-6 px-6 py-28 text-center">
      <!-- Señal tipo "pare" -->
      <div
        class="flex size-28 items-center justify-center bg-brand font-display text-4xl font-black text-ink [clip-path:polygon(30%_0,70%_0,100%_30%,100%_70%,70%_100%,30%_100%,0_70%,0_30%)]"
        aria-hidden="true"
      >
        404
      </div>
      <h1 class="m-0 font-display text-[clamp(36px,5vw,60px)] leading-none font-black tracking-[-0.02em] uppercase">
        Te desviaste del camino
      </h1>
      <p class="m-0 text-[19px] text-soft">La página que buscas no existe o cambió de dirección.</p>
      <Button href={withBase('/')} size="lg">Volver al inicio</Button>
    </div>
  </section>
</BaseLayout>
