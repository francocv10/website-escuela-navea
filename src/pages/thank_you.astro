---
import Button from '../components/ui/Button.astro';
import { whatsappUrl } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="¡Gracias!" noindex>
  <section class="bg-ink">
    <div class="mx-auto flex max-w-[720px] flex-col items-center gap-6 px-6 py-28 text-center">
      <div class="flex size-20 items-center justify-center rounded-full bg-brand text-ink" aria-hidden="true">
        <svg viewBox="0 0 24 24" class="size-9" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4.5 12.5l5 5 10-11" />
        </svg>
      </div>
      <h1 class="m-0 font-display text-[clamp(36px,5vw,60px)] leading-none font-black tracking-[-0.02em] uppercase">
        ¡Listo, recibimos tus datos!
      </h1>
      <p class="m-0 text-[19px] text-soft">Te contactaremos dentro del día hábil para coordinar tu primera clase.</p>
      <div class="flex flex-wrap justify-center gap-3.5">
        <Button href="/" size="lg">Volver al inicio</Button>
        <Button href={whatsappUrl} size="lg" variant="outline">Escríbenos por WhatsApp</Button>
      </div>
    </div>
  </section>
</BaseLayout>
