---
import type { HTMLAttributes } from 'astro/types';

type Props = {
  href?: string;
  variant?: 'primary' | 'outline' | 'dark';
  size?: 'md' | 'lg';
  type?: 'button' | 'submit';
  class?: string;
} & Omit<HTMLAttributes<'a'>, 'type'>;

const { href, variant = 'primary', size = 'md', type = 'button', class: className, ...rest } = Astro.props;

const variants = {
  primary: 'bg-brand text-ink hover:bg-brand-dark font-extrabold',
  outline: 'border-2 border-white text-white hover:border-brand hover:text-brand font-bold',
  dark: 'bg-ink text-white hover:bg-brand hover:text-ink font-bold',
};

const sizes = {
  md: 'px-[22px] py-3 text-[15px] rounded-xl',
  lg: 'px-[30px] py-[18px] text-[17px] rounded-[14px]',
};

const classes = [
  'inline-flex items-center justify-center text-center font-display transition-colors cursor-pointer',
  variants[variant],
  // El borde de 2px del outline se compensa con 2px menos de padding.
  variant === 'outline' && size === 'lg' ? 'px-[28px] py-4 text-[17px] rounded-[14px]' : sizes[size],
  className,
];
---

{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes}>
      <slot />
    </button>
  )
}
