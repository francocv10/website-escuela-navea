---
interface Props {
  tone?: 'dark' | 'light';
  as?: 'div' | 'article' | 'li';
  class?: string;
}

const { tone = 'dark', as: Tag = 'div', class: className } = Astro.props;

const tones = {
  dark: 'bg-surface border-edge',
  light: 'bg-white border-[#e6e6e6] hover:border-ink transition-colors',
};
---

<Tag class:list={['flex flex-col rounded-2xl border p-7', tones[tone], className]}>
  <slot />
</Tag>
