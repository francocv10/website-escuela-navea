---
interface Props {
  title: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2';
}

const { title, align = 'left', as: Tag = 'h2' } = Astro.props;
---

<Tag
  class:list={[
    'm-0 max-w-[640px] font-display text-[clamp(34px,4.4vw,52px)] leading-[1.05] font-black tracking-[-0.01em] text-balance',
    align === 'center' && 'mx-auto text-center',
  ]}
>
  {title}
</Tag>
