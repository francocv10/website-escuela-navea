---
interface Props {
  eyebrow: string;
  title: string;
  /** Color del eyebrow: amarillo sobre fondos oscuros; nunca amarillo sobre blanco. */
  eyebrowTone?: 'brand' | 'muted' | 'ink';
  align?: 'left' | 'center';
  as?: 'h1' | 'h2';
}

const { eyebrow, title, eyebrowTone = 'brand', align = 'left', as: Tag = 'h2' } = Astro.props;

const tones = { brand: 'text-brand', muted: 'text-[#6b6b6b]', ink: 'text-ink' };
---

<div class:list={['flex max-w-[640px] flex-col gap-3', align === 'center' && 'items-center text-center']}>
  <p class:list={['m-0 font-display text-sm font-extrabold tracking-[0.14em] uppercase', tones[eyebrowTone]]}>
    {eyebrow}
  </p>
  <Tag class="m-0 font-display text-[clamp(34px,4.4vw,52px)] leading-[1.05] font-black tracking-[-0.01em] text-balance">
    {title}
  </Tag>
</div>
