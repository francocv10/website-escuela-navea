---
// Acordeón sobre <details>: sin JS funciona de forma nativa (mismo `name` = se abren de a uno).
// Con JS, src/scripts/accordion.ts anima apertura/cierre (altura + fundido del contenido) en todos los navegadores.
interface Item {
  id: string;
  question: string;
  answer: string;
}

interface Props {
  items: Item[];
  name?: string;
  openFirst?: boolean;
}

const { items, name = 'accordion', openFirst = true } = Astro.props;
---

<div class="flex flex-col gap-3">
  {
    items.map((item, i) => {
      const isOpen = openFirst && i === 0;
      return (
        <details
          name={name}
          open={isOpen}
          data-accordion
          data-accordion-group={name}
          data-expanded={isOpen ? '' : undefined}
          class="group overflow-hidden rounded-[14px] border border-edge-light bg-white transition-[border-color] duration-300 hover:border-ink data-expanded:border-ink"
        >
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-[22px] text-left text-ink [&::-webkit-details-marker]:hidden">
            <span class="font-display text-lg font-bold">{item.question}</span>
            <span
              class="flex size-8 shrink-0 items-center justify-center rounded-full bg-ink text-brand transition-[rotate] duration-300 group-data-expanded:rotate-180 motion-reduce:transition-none"
              aria-hidden="true"
            >
              <svg viewBox="0 0 16 16" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <path d="M2 8h12" />
                <path d="M8 2v12" class="origin-center transition-transform duration-300 group-data-expanded:scale-y-0" />
              </svg>
            </span>
          </summary>
          <p data-accordion-content class="m-0 px-6 pb-6 text-base text-pretty text-text-on-light">
            {item.answer}
          </p>
        </details>
      );
    })
  }
</div>

<script>
  import '../../scripts/accordion';
</script>
