---
interface Props {
  variant?: 'light' | 'outline';
  class?: string;
}

const { variant = 'light', class: className } = Astro.props;
---

{
  variant === 'outline' ? (
    <span
      class:list={[
        'inline-flex items-center gap-2.5 self-start rounded-full border border-[#333] py-1.5 pr-3.5 pl-2 text-sm text-[#ccc]',
        className,
      ]}
    >
      <span class="block size-2.5 rounded-full bg-brand" aria-hidden="true" />
      <slot />
    </span>
  ) : (
    <span class:list={['rounded-full bg-[#f0f0f0] px-3 py-[5px] text-[13px] font-bold text-[#333]', className]}>
      <slot />
    </span>
  )
}
