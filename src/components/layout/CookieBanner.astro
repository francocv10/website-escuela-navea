---
// Aviso de cookies + panel de preferencias. Sin JS no se muestra: en ese caso no se carga nada que requiera consentimiento.
// Cualquier elemento con [data-cookie-settings] (p. ej. el enlace del footer) reabre el panel.
import Button from '../ui/Button.astro';

const categories = [
  {
    id: 'necessary',
    title: 'Necesarias',
    text: 'Permiten que el sitio funcione y recuerdan tu elección sobre cookies. No se pueden desactivar.',
    locked: true,
  },
  {
    id: 'analytics',
    title: 'Analítica',
    text: 'Nos ayudan a entender cómo se usa el sitio (páginas visitadas, inscripciones) para mejorarlo.',
    locked: false,
  },
  {
    id: 'marketing',
    title: 'Marketing',
    text: 'Permiten medir campañas en redes sociales y mostrarte anuncios relevantes.',
    locked: false,
  },
];
---

<div
  id="cookie-banner"
  role="region"
  aria-label="Aviso de cookies"
  hidden
  class="fixed inset-x-4 bottom-4 z-70 mx-auto max-w-[760px] rounded-2xl border border-edge-2 bg-surface p-5 shadow-[0_12px_40px_rgba(0,0,0,0.5)] sm:p-6"
>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
    <p class="m-0 text-[15px] text-soft">
      Usamos cookies propias y de terceros para que el sitio funcione y, si lo aceptas, para analizar su uso.
      <a href="/cookies" class="font-semibold text-white underline underline-offset-2 hover:text-brand">Más información</a>
    </p>
    <div class="flex shrink-0 flex-wrap gap-2.5">
      <Button data-cookie-action="reject" variant="outline" size="sm" class="flex-1 sm:flex-none">Rechazar</Button>
      <Button data-cookie-action="accept" size="sm" class="flex-1 sm:flex-none">Aceptar</Button>
      <button
        type="button"
        data-cookie-settings
        class="w-full cursor-pointer text-sm font-semibold text-muted underline underline-offset-2 transition-colors hover:text-brand"
      >
        Configurar
      </button>
    </div>
  </div>
</div>

<dialog
  id="cookie-settings"
  aria-labelledby="cookie-settings-title"
  class="m-auto w-[calc(100%-32px)] max-w-[560px] rounded-2xl border border-edge-2 bg-surface p-0 text-white backdrop:bg-black/70"
>
  <form method="dialog" class="flex flex-col gap-5 p-6">
    <div class="flex items-start justify-between gap-4">
      <h2 id="cookie-settings-title" class="m-0 font-display text-xl font-extrabold">Preferencias de cookies</h2>
      <button type="submit" value="close" aria-label="Cerrar" class="cursor-pointer text-2xl leading-none text-muted hover:text-brand">
        &times;
      </button>
    </div>
    <p class="m-0 text-[15px] text-soft">
      Elige qué cookies permites. Puedes cambiar tu elección cuando quieras desde el pie de página.
      <a href="/cookies" class="font-semibold text-white underline underline-offset-2 hover:text-brand">Política de cookies</a>
    </p>
    <ul class="m-0 flex list-none flex-col gap-3 p-0">
      {
        categories.map((c) => (
          <li class="rounded-xl border border-edge-2 bg-ink p-4">
            <label class="flex cursor-pointer items-start justify-between gap-4">
              <span class="flex flex-col gap-1">
                <span class="font-bold">{c.title}</span>
                <span class="text-sm text-muted">{c.text}</span>
              </span>
              <input
                type="checkbox"
                name={c.id}
                checked={c.locked}
                disabled={c.locked}
                class="mt-1 size-5 shrink-0 cursor-pointer disabled:cursor-not-allowed"
              />
            </label>
          </li>
        ))
      }
    </ul>
    <div class="flex flex-wrap justify-end gap-2.5">
      <Button data-cookie-action="reject" variant="outline" size="sm">Rechazar todas</Button>
      <Button data-cookie-action="save" variant="outline" size="sm">Guardar selección</Button>
      <Button data-cookie-action="accept" size="sm">Aceptar todas</Button>
    </div>
  </form>
</dialog>

<script>
  import { activateScripts, readConsent, saveConsent, type ConsentCategory } from '../../scripts/consent';

  const banner = document.getElementById('cookie-banner') as HTMLElement;
  const dialog = document.getElementById('cookie-settings') as HTMLDialogElement;
  const toggles = dialog.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:not(:disabled)');

  const existing = readConsent();
  if (existing) activateScripts(existing);
  else banner.hidden = false;

  function decide(choice: Record<ConsentCategory, boolean>) {
    saveConsent(choice);
    banner.hidden = true;
    if (dialog.open) dialog.close();
  }

  function selection() {
    const choice = { analytics: false, marketing: false };
    toggles.forEach((t) => (choice[t.name as ConsentCategory] = t.checked));
    return choice;
  }

  document.addEventListener('click', (event) => {
    const target = event.target as Element;

    if (target.closest('[data-cookie-settings]')) {
      event.preventDefault();
      const current = readConsent();
      toggles.forEach((t) => (t.checked = current?.[t.name as ConsentCategory] ?? false));
      dialog.showModal();
      return;
    }

    const action = target.closest<HTMLElement>('[data-cookie-action]')?.dataset.cookieAction;
    if (!action) return;
    event.preventDefault();
    if (action === 'accept') decide({ analytics: true, marketing: true });
    else if (action === 'reject') decide({ analytics: false, marketing: false });
    else if (action === 'save') decide(selection());
  });
</script>
