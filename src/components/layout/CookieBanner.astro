---
// Aviso de cookies + panel de preferencias. Sin JS no se muestra: en ese caso no se carga nada que requiera consentimiento.
// Cualquier elemento con [data-cookie-settings] (p. ej. el enlace del footer) reabre el panel.
import Button from '../ui/Button.astro';

const categories = [
  {
    id: 'necessary',
    title: 'Necesarias',
    text: 'Permiten que el sitio funcione y recuerdan tu elección sobre cookies. No se pueden desactivar.',
    locked: true,
  },
  {
    id: 'analytics',
    title: 'Analítica',
    text: 'Nos ayudan a entender cómo se usa el sitio (páginas visitadas, inscripciones) para mejorarlo.',
    locked: false,
  },
  {
    id: 'marketing',
    title: 'Marketing',
    text: 'Permiten medir campañas en redes sociales y mostrarte anuncios relevantes.',
    locked: false,
  },
];
---

<div
  id="cookie-banner"
  role="region"
  aria-label="Aviso de cookies"
  hidden
  class="fixed inset-x-4 bottom-4 z-70 mx-auto max-w-[760px] rounded-2xl border border-edge-2 bg-surface p-5 shadow-[0_12px_40px_rgba(0,0,0,0.5)] sm:p-6"
>
  <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between md:gap-8">
    <p class="m-0 text-[15px] leading-relaxed text-soft">
      Usamos cookies propias y de terceros para que el sitio funcione y, si lo aceptas, para analizar su uso.{' '}
      <a href="/cookies" class="font-semibold whitespace-nowrap text-white underline underline-offset-2 hover:text-brand">
        Más información
      </a>
    </p>
    <div class="flex shrink-0 flex-wrap items-center gap-2.5">
      <button
        type="button"
        data-cookie-settings
        class="order-last w-full cursor-pointer py-1 text-sm font-semibold text-muted underline underline-offset-2 transition-colors hover:text-brand md:order-first md:mr-2 md:w-auto"
      >
        Configurar
      </button>
      <Button data-cookie-action="reject" variant="outline" size="sm" class="min-w-[112px] flex-1 md:flex-none">Rechazar</Button>
      <Button data-cookie-action="accept" size="sm" class="min-w-[112px] flex-1 md:flex-none">Aceptar</Button>
    </div>
  </div>
</div>

<dialog
  id="cookie-settings"
  aria-labelledby="cookie-settings-title"
  class="m-auto w-[calc(100%-32px)] max-w-[560px] rounded-2xl border border-edge-2 bg-surface p-0 text-white backdrop:bg-black/70"
>
  <form method="dialog" class="flex flex-col gap-5 p-6">
    <div class="flex items-start justify-between gap-4">
      <h2 id="cookie-settings-title" class="m-0 font-display text-xl font-extrabold">Preferencias de cookies</h2>
      <button type="submit" value="close" aria-label="Cerrar" class="cursor-pointer text-2xl leading-none text-muted hover:text-brand">
        &times;
      </button>
    </div>
    <p class="m-0 text-[15px] leading-relaxed text-soft">
      Elige qué cookies permites. Puedes cambiar tu elección cuando quieras desde el pie de página.{' '}
      <a href="/cookies" class="font-semibold whitespace-nowrap text-white underline underline-offset-2 hover:text-brand">
        Política de cookies
      </a>
    </p>
    <ul class="m-0 flex list-none flex-col gap-3 p-0">
      {
        categories.map((c) => (
          <li class="rounded-xl border border-edge-2 bg-ink p-4">
            <label class:list={['flex items-center justify-between gap-5', !c.locked && 'cursor-pointer']}>
              <span class="flex flex-col gap-1">
                <span class="font-bold">{c.title}</span>
                <span class="text-sm leading-relaxed text-muted">{c.text}</span>
              </span>
              {c.locked ? (
                <span class="shrink-0 rounded-full bg-brand/15 px-2.5 py-1 text-xs font-bold whitespace-nowrap text-brand">
                  Siempre activas
                </span>
              ) : (
                <input
                  type="checkbox"
                  role="switch"
                  name={c.id}
                  class="relative h-6 w-11 shrink-0 cursor-pointer appearance-none rounded-full bg-white/20 transition-colors duration-200 outline-offset-2 before:absolute before:top-0.5 before:left-0.5 before:size-5 before:rounded-full before:bg-white before:transition-transform before:duration-200 checked:bg-brand checked:before:translate-x-5 checked:before:bg-ink focus-visible:outline-2 focus-visible:outline-brand motion-reduce:transition-none motion-reduce:before:transition-none"
                />
              )}
            </label>
          </li>
        ))
      }
    </ul>
    <div class="flex flex-col-reverse gap-2.5 border-t border-edge-2 pt-5 sm:flex-row sm:justify-end">
      <Button data-cookie-action="reject" variant="outline" size="sm" class="w-full sm:w-auto">Rechazar todas</Button>
      <Button data-cookie-action="save" variant="outline" size="sm" class="w-full sm:w-auto">Guardar selección</Button>
      <Button data-cookie-action="accept" size="sm" class="w-full sm:w-auto">Aceptar todas</Button>
    </div>
  </form>
</dialog>

<script>
  import '../../scripts/cookie-banner';
</script>
