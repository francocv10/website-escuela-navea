---
import { withBase } from '../../utils/url';
import { getCollection } from 'astro:content';
import { formatCLP } from '../../config/site';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const courses = (await getCollection('courses')).sort((a, b) => a.data.order - b.data.order);
---

<section id="cursos" class="bg-paper text-ink">
  <div class="mx-auto flex max-w-[1240px] flex-col gap-12 px-6 py-24">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading title="Elige la licencia que necesitas" />
      <p class="m-0 max-w-[380px] text-pretty text-text-on-light">
        Todos los cursos incluyen clases teóricas, prácticas y preparación para el examen municipal.
      </p>
    </div>

    <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(100%,270px),1fr))] gap-5 p-0">
      {
        courses.map(({ id, data }) => (
          <Card as="li" tone="light" class="group gap-5">
            <div class="flex items-start justify-between">
              <div class="flex size-14 items-center justify-center rounded-[14px] bg-ink font-display text-xl font-black text-brand">
                {data.code}
              </div>
              <Badge>{data.tag}</Badge>
            </div>
            <div class="flex flex-col gap-1.5">
              <h3 class="m-0 font-display text-[22px] leading-[1.2] font-extrabold">{data.name}</h3>
              <p class="m-0 text-[15px] text-pretty text-text-on-light">{data.description}</p>
            </div>
            <dl class="m-0 mt-auto flex flex-col gap-2 border-t border-edge-light pt-4 text-[15px]">
              <div class="flex justify-between">
                <dt class="text-muted-on-light">Duración</dt>
                <dd class="m-0 font-bold">{data.duration}</dd>
              </div>
              <div class="flex items-baseline justify-between">
                <dt class="text-muted-on-light">Desde</dt>
                <dd class="m-0 font-display text-[22px] font-black tabular-nums">{formatCLP(data.price)}</dd>
              </div>
            </dl>
            {/* Al pasar sobre la tarjeta, su acción se enciende: toda la tarjeta apunta a "Ver curso". */}
            <Button href={withBase(`/cursos/${id}`)} variant="dark" class="group-hover:bg-brand group-hover:text-ink">
              Ver curso <span class="sr-only">{data.name}</span>
            </Button>
          </Card>
        ))
      }
    </ul>
  </div>
</section>
