---
import { getCollection } from 'astro:content';
import { formatCLP, site } from '../../config/site';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  showPrices?: boolean;
}

const { showPrices = true } = Astro.props;
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

// Cada servicio abre WhatsApp con un mensaje que ya indica qué se quiere contratar.
const whatsappFor = (name: string, sessions: number) =>
  `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(`Hola, quiero información sobre el servicio: ${name} (${sessions} clases).`)}`;
---

<section id="servicios" class="bg-white text-ink">
  <div class="mx-auto flex max-w-[1240px] flex-col gap-12 px-6 py-24">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading title="Otros servicios" />
      <p class="m-0 max-w-[380px] text-pretty text-[#555]">
        ¿Necesitas más práctica o reforzar la teoría? Suma clases adicionales a tu curso o tómalas por separado.
      </p>
    </div>

    <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(100%,270px),1fr))] gap-5 p-0">
      {
        services.map(({ data }) => (
          <Card as="li" tone="light" class="group gap-5">
            <div class="flex items-start justify-between">
              <div class="flex size-14 flex-col items-center justify-center rounded-[14px] bg-ink font-display leading-none text-brand">
                <span class="text-xl font-black tabular-nums">{data.sessions}</span>
                <span class="text-[10px] font-bold tracking-[0.08em] uppercase">clases</span>
              </div>
              <Badge>{data.kind}</Badge>
            </div>
            <h3 class="m-0 font-display text-[22px] leading-[1.2] font-extrabold">{data.name}</h3>
            <dl class="m-0 mt-auto flex flex-col gap-2 border-t border-[#eee] pt-4 text-[15px]">
              <div class="flex justify-between">
                <dt class="text-[#6b6b6b]">Cantidad</dt>
                <dd class="m-0 font-bold">{data.sessions} clases</dd>
              </div>
              {showPrices && (
                <div class="flex items-baseline justify-between">
                  <dt class="text-[#6b6b6b]">Valor</dt>
                  <dd class="m-0 font-display text-[22px] font-black tabular-nums">{formatCLP(data.price)}</dd>
                </div>
              )}
            </dl>
            <Button
              href={whatsappFor(data.name, data.sessions)}
              target="_blank"
              rel="noopener"
              variant="dark"
              class="group-hover:bg-brand group-hover:text-ink"
            >
              Consultar <span class="sr-only">{data.name}, {data.sessions} clases, por WhatsApp</span>
            </Button>
          </Card>
        ))
      }
    </ul>
  </div>
</section>
