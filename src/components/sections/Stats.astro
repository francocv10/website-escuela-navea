---
// TODO: confirmar cifras con el cliente.
const stats = [
  { value: '15+', label: 'años de experiencia' },
  { value: '8.000', label: 'alumnos aprobados' },
  { value: '94%', label: 'aprobación en primer intento' },
  { value: '12', label: 'autos con doble comando' },
];
---

<section class="bg-surface" aria-label="NAVEA en cifras">
  <dl class="mx-auto m-0 grid max-w-[1240px] grid-cols-2 gap-x-6 gap-y-8 px-6 py-12 md:grid-cols-4">
    {
      stats.map((stat) => (
        <div class="flex flex-col-reverse gap-2 border-l border-edge-2 pl-5">
          <dt class="text-[15px] leading-snug text-muted">{stat.label}</dt>
          <dd class="m-0 font-display text-[clamp(34px,4vw,44px)] leading-none font-black tabular-nums">{stat.value}</dd>
        </div>
      ))
    }
  </dl>
</section>
