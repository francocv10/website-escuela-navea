---
// TODO: confirmar cifras con el cliente.
const stats = [
  { value: '15+', label: 'años de experiencia' },
  { value: '8.000', label: 'alumnos aprobados' },
  { value: '94%', label: 'aprobación en primer intento' },
  { value: '12', label: 'autos con doble comando' },
];
---

<section class="bg-surface" aria-label="NAVEA en cifras">
  <dl class="mx-auto m-0 grid max-w-[1240px] grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-8 px-6 py-12">
    {
      stats.map((stat) => (
        <div class="flex flex-col-reverse gap-1 border-l-[3px] border-brand pl-5">
          <dt class="text-[15px] text-muted">{stat.label}</dt>
          <dd class="m-0 font-display text-[44px] leading-none font-black">{stat.value}</dd>
        </div>
      ))
    }
  </dl>
</section>
