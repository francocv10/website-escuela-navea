---
import SectionHeading from '../ui/SectionHeading.astro';

const benefits = [
  { title: 'Instructores certificados', desc: 'Profesionales acreditados con años de experiencia enseñando a principiantes.' },
  { title: 'Autos con doble comando', desc: 'Practicas seguro desde la primera clase, con el instructor siempre en control.' },
  { title: 'Horarios flexibles', desc: 'Clases de lunes a sábado, en la mañana, tarde o después del trabajo.' },
  { title: 'Examen teórico', desc: 'Simulador con preguntas reales del cuestionario oficial de Conaset.' },
  { title: 'Examen práctico', desc: 'Practicamos en la ruta del examen municipal para que llegues sin sorpresas.' },
];
---

<section id="nosotros" class="bg-ink">
  <div class="mx-auto flex max-w-[1240px] flex-col gap-12 px-6 py-24">
    <SectionHeading title="Aprendes tranquilo, llegas preparado" />
    <ul class="m-0 grid list-none gap-x-8 gap-y-10 p-0 sm:grid-cols-2 lg:grid-cols-5">
      {
        benefits.map((b) => (
          <li class="relative flex flex-col gap-2.5 border-t border-edge-2 pt-6">
            <span class="absolute -top-px left-0 block h-1 w-7 bg-brand" aria-hidden="true" />
            <h3 class="m-0 font-display text-xl leading-tight font-extrabold text-balance">{b.title}</h3>
            <p class="m-0 text-[15px] text-pretty text-muted">{b.desc}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
