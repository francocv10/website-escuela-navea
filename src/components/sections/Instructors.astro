---
import PhotoPlaceholder from '../ui/PhotoPlaceholder.astro';
import SectionHeading from '../ui/SectionHeading.astro';

// TODO: nombres y fotos reales de los instructores.
const instructors = [
  { name: 'Nombre Apellido', role: '18 años de experiencia' },
  { name: 'Nombre Apellido', role: '12 años de experiencia' },
  { name: 'Nombre Apellido', role: '9 años de experiencia' },
  { name: 'Nombre Apellido', role: '6 años de experiencia' },
];
---

<section class="bg-white text-ink">
  <div class="mx-auto flex max-w-[1240px] flex-col gap-10 px-6 py-24">
    <SectionHeading eyebrow="Instructores" title="Quienes te acompañan" eyebrowTone="ink" />
    <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(100%,240px),1fr))] gap-5 p-0">
      {
        instructors.map((person) => (
          <li class="flex flex-col gap-3.5">
            <PhotoPlaceholder label="foto instructor" tone="light" class="aspect-square" />
            <div class="flex flex-col gap-0.5">
              <p class="m-0 font-display text-[19px] font-extrabold">{person.name}</p>
              <p class="m-0 text-[15px]">{person.role}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
