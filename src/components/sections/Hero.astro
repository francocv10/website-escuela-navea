---
import { googleRatingLabel, site } from '../../config/site';
import Button from '../ui/Button.astro';
import PhotoPlaceholder from '../ui/PhotoPlaceholder.astro';
---

<section id="inicio" class="relative overflow-hidden">
  <div
    class="mx-auto grid max-w-[1240px] grid-cols-[repeat(auto-fit,minmax(min(100%,460px),1fr))] items-center gap-14 px-6 pt-[72px] pb-[88px]"
  >
    <div class="flex flex-col gap-7">
      <h1
        class="m-0 font-display text-[clamp(44px,6.4vw,84px)] leading-[0.98] font-black tracking-[-0.02em] text-balance uppercase"
      >
        Aprende a conducir con <span class="text-brand">confianza</span>
      </h1>
      <p class="m-0 max-w-[520px] text-[19px] text-pretty text-soft">
        Tu licencia, sin estrés. Instructores certificados, autos con doble comando y horarios que se adaptan a ti.
      </p>
      <div class="grid gap-3 min-[430px]:flex min-[430px]:flex-wrap min-[430px]:gap-3.5">
        <Button href="#contacto" size="lg">Reserva tu clase</Button>
        <Button href="#cursos" size="lg" variant="outline">Ver cursos</Button>
      </div>
      <p class="m-0 flex flex-wrap gap-x-2 text-[15px] text-muted">
        <span>Clase B y licencias profesionales</span>
        <span aria-hidden="true">·</span>
        <span class="whitespace-nowrap">{site.address.street}, {site.address.city}</span>
      </p>
    </div>

    <PhotoPlaceholder label="foto: persona joven al volante, luz natural" class="relative aspect-[4/4.4] rounded-3xl">
      <div
        class="absolute right-5 bottom-5 left-5 flex items-center gap-3.5 rounded-2xl border border-edge-2 bg-ink px-[18px] py-4 font-sans text-white"
      >
        <div
          class="flex size-11 shrink-0 items-center justify-center rounded-full bg-brand font-display text-base font-black text-ink"
        >
          {googleRatingLabel}
        </div>
        <div class="text-left leading-[1.35]">
          <div class="text-[15px] font-bold">Calificación en Google</div>
          <div class="text-sm text-muted">
            {site.google.reviewCount > 0 ? `${site.google.reviewCount} reseñas de alumnos` : 'Basado en reseñas de alumnos'}
          </div>
        </div>
      </div>
    </PhotoPlaceholder>
  </div>
</section>
