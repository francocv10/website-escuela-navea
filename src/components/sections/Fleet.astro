---
import PhotoPlaceholder from '../ui/PhotoPlaceholder.astro';
import SectionHeading from '../ui/SectionHeading.astro';

// TODO: reemplazar por fotos reales con <Image /> de astro:assets.
const photos = [
  'foto: flota de autos',
  'foto: doble comando',
  'foto: sala de clases',
  'foto: fachada sede',
  'foto: alumno en clase práctica',
];
---

<section class="bg-ink">
  <div class="mx-auto flex max-w-[1240px] flex-col gap-10 px-6 py-24">
    <SectionHeading title="Autos nuevos, sala equipada" />
    <div class="grid auto-rows-[220px] gap-4 sm:grid-cols-2 lg:auto-rows-[240px] lg:grid-cols-4">
      {
        photos.map((label, i) => (
          <PhotoPlaceholder label={label} class={i === 0 ? 'row-span-2 sm:col-span-2 lg:row-span-2' : undefined} />
        ))
      }
    </div>
  </div>
</section>
